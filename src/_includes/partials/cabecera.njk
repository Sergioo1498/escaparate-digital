<header class="cabecera">
  <div class="cabecera__interior">
    <a class="marca" href="/" aria-label="{{ site.title }}, ir al inicio">
      {% include "partials/logo.njk" %}
    </a>
    <nav class="menu" aria-label="Navegación principal">
      <ul>
        <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Inicio</a></li>
        <li><a href="/archivo/"{% if page.url == "/archivo/" or seccion == "archivo" %} aria-current="page"{% endif %}>Archivo</a></li>
        <li><a href="/etiquetas/"{% if seccion == "etiquetas" %} aria-current="page"{% endif %}>Etiquetas</a></li>
        <li><a href="/sobre/"{% if page.url == "/sobre/" %} aria-current="page"{% endif %}>Sobre el blog</a></li>
      </ul>
    </nav>
  </div>
  <div class="toldo" aria-hidden="true"></div>
</header>
