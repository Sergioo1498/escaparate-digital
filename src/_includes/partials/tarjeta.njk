<article class="tarjeta{% if destacada %} tarjeta--destacada{% endif %}">
  <a class="tarjeta__imagen" href="{{ entrada.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ entrada.data.portada }}" alt="" width="1200" height="600" loading="{% if destacada %}eager{% else %}lazy{% endif %}">
  </a>
  <div class="tarjeta__cuerpo">
    <p class="meta">
      <time datetime="{{ entrada.date | fechaISO }}">{{ entrada.date | fechaLarga }}</time>
      <span aria-hidden="true">·</span>
      <span>{{ entrada.content | minutosLectura }} min de lectura</span>
    </p>
    <h2 class="tarjeta__titulo"><a href="{{ entrada.url }}">{{ entrada.data.title }}</a></h2>
    <p class="tarjeta__resumen">{{ entrada.data.description }}</p>
    <ul class="etiquetas" aria-label="Etiquetas">
      {%- for etiqueta in entrada.data.etiquetas %}
      <li><a href="/etiquetas/{{ etiqueta | slugify }}/">{{ etiqueta }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</article>
